{
    "exeName":"@WEBOS_INSTALL_SBINDIR@/luneos-print-adapter",
    "trustLevel": "oem",
    "type": "privileged",
    "allowedNames": ["com.palm.printmgr", "com.webos.service.print", "org.webosports.service.print"],
    "permissions": [
        {
            "service":"com.palm.printmgr",
            "inbound":["*"],
            "outbound":["*"]
        },
        {
            "service":"com.webos.service.print",
            "inbound":["*"],
            "outbound":["*"]
        },
        {
            "service":"org.webosports.service.print",
            "inbound":["*"],
            "outbound":["*"]
        }
    ]
}
